rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ["fishyourstyle.supp@gmail.com"];
    }

    // Admin-only stats
    match /adminStats/{id} {
      allow read, write: if isAdmin();
    }
    match /adminStatsDaily/{id} {
      allow read, write: if isAdmin();
    }

    // Users: owner can READ, only admin can WRITE (secure)
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if isAdmin();
    }

    // Products / Categories / Themes
    match /products/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /categories/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /designThemes/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Orders
    match /orders/{id} {
      allow create: if false;

      // Admin can read everything, user can read only their orders (by userId OR email)
      allow read: if isAdmin()
        || (request.auth != null && resource.data.userId == request.auth.uid)
        || (request.auth != null && resource.data.customerEmail == request.auth.token.email);

      allow update, delete: if isAdmin();
    }

    // Contact messages
    match /contactMessages/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}
